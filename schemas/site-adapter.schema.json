{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/site-adapter.schema.json",
  "title": "Marketing Site Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "siteId",
    "version",
    "lastVerifiedAt",
    "persona",
    "domains",
    "policy",
    "auth",
    "flows"
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "kind"
      ],
      "description": "kind'e göre beklenen alanlar: role -> role (+name); label, placeholder, name, id, testId, text -> value; css -> value (kısa ve bağlama alınmış). Öncelik sırası: role+name > label > placeholder > stabil name/id/testId > kısa CSS fallback. frame varsa locator önce verilen CSS frame zincirinde aranır (iframe desteği).",
      "properties": {
        "kind": {
          "description": "testId data-testid benzeri test kimliği, text görünür metin eşleşmesidir.",
          "enum": [
            "role",
            "label",
            "placeholder",
            "name",
            "id",
            "testId",
            "text",
            "css"
          ]
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "frame": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "İç içe iframe CSS seçici zinciri; örn. ['#editor-iframe', '.toolbar-frame']. Boş veya yoksa ana sayfa kullanılır."
        }
      }
    },
    "fieldValue": {
      "type": "object",
      "required": [
        "valueFrom",
        "locators"
      ],
      "properties": {
        "valueFrom": {
          "type": "string",
          "description": "product-profile.json içindeki JSON path (ör. product.name, product.description.medium, assets.logoPath)."
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "fieldType": {
          "enum": [
            "text",
            "textarea",
            "email",
            "password",
            "number",
            "date",
            "select",
            "multiselect",
            "checkbox",
            "radio",
            "file",
            "richtext",
            "hidden"
          ],
          "default": "text"
        },
        "optionsValueFrom": {
          "type": "string",
          "description": "fieldType select/multiselect ise seçenek listesinin product-profile path'i; runtime eşleşen option value'sunu seçer."
        },
        "uploadRef": {
          "type": "string",
          "description": "fieldType file ise yüklenecek varlığın vault:// referansı."
        },
        "condition": {
          "type": "object",
          "description": "Koşullu alan: belirtilen başka bir alanın değeri eşleşirse doldurulur.",
          "required": [
            "field",
            "equals"
          ],
          "properties": {
            "field": {
              "type": "string",
              "description": "Aynı flow/steps içindeki başka bir valueFrom path'i."
            },
            "equals": {
              "type": "string"
            }
          }
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "webStep": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "Çok adımlı (wizard) form akışının bir adımı; her adım kendi URL, alan ve bekleme tanımını taşıyabilir.",
      "properties": {
        "name": {
          "type": "string"
        },
        "entryUrl": {
          "type": "string",
          "format": "uri",
          "description": "Adım farklı bir URL'de başlıyorsa girilir; aksi hâlde önceki adımın devamında kalınır."
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldValue"
          }
        },
        "submit": {
          "type": "object",
          "required": [
            "locator",
            "requiresApproval"
          ],
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "requiresApproval": {
              "type": "boolean",
              "const": false,
              "description": "0-HITL uyumluluk alanı; daima false. Ara/son adım submit kararı policy ve Autonomous Decision Engine tarafından verilir."
            }
          }
        },
        "wait": {
          "type": "object",
          "required": [
            "kind",
            "matches"
          ],
          "description": "Sonraki adıma geçmeden beklenen sinyal.",
          "properties": {
            "kind": {
              "enum": [
                "url",
                "text",
                "selector"
              ]
            },
            "matches": {
              "type": "string"
            }
          }
        }
      }
    },
    "apiRequest": {
      "type": "object",
      "required": [
        "name",
        "method",
        "path",
        "payloadFrom"
      ],
      "description": "kind=api akışlarında çalıştırılacak tek HTTP isteği. Değerler product-profile path'lerinden gelir; secret'lar vault:// referansıdır ve log'a yazılmaz.",
      "properties": {
        "name": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "path": {
          "type": "string"
        },
        "headersFrom": {
          "type": "object",
          "description": "header adı -> vault:// referansı (ör. Authorization). Düz metin secret yazılmaz.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "payloadFrom": {
          "type": "object",
          "description": "JSON body: payload alanı -> product-profile JSON path'i.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "idempotencyHeader": {
          "type": "string",
          "description": "Site destekliyorsa idempotency anahtarının gönderileceği header adı (ör. Idempotency-Key)."
        },
        "expectStatus": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        },
        "successExtract": {
          "type": "object",
          "description": "Başarı response'undan audit'e yazılacak alanlar: kayıt adı -> JSONPath (ör. $.data.listingUrl).",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "successSignal": {
      "type": "object",
      "required": [
        "kind",
        "matches"
      ],
      "properties": {
        "kind": {
          "enum": [
            "url",
            "text",
            "jsonPath",
            "status",
            "apiResponseId"
          ]
        },
        "matches": {
          "type": "string"
        }
      }
    },
    "retryPolicy": {
      "type": "object",
      "description": "Geçici hatalar için üst sınırı olan retry/backoff politikası. Belirsiz sonuçlar asla otomatik retry edilmez; ambiguous kuyruğuna düşer.",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "default": 3
        },
        "backoffSeconds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Denemeler arası bekleme süresi dizisi; uzunluğu en az maxAttempts kadar olmalıdır."
        },
        "retryOn": {
          "type": "array",
          "items": {
            "enum": [
              "timeout",
              "networkError",
              "rateLimited",
              "ambiguousResponse"
            ]
          },
          "description": "ambiguousResponse yalnızca idempotency doğrulaması yapılabiliyorsa listeye girer."
        }
      }
    },
    "quietHours": {
      "type": "object",
      "required": [
        "startLocal",
        "endLocal",
        "timezone"
      ],
      "properties": {
        "startLocal": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "endLocal": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "execution"
      ],
      "description": "kind varsayılan olarak 'web'dir. kind=email kendi gelen kutusundaki doğrulama e-postasının işlenmesidir; kind=api resmî/keşfedilmiş HTTP API çağrısıdır.",
      "properties": {
        "kind": {
          "enum": [
            "web",
            "email",
            "api"
          ]
        },
        "execution": {
          "enum": [
            "browser_auto",
            "api_auto",
            "auto_full"
          ],
          "description": "0-HITL execution mode. browser_auto ve api_auto belirli transportu otomatik yürütür; auto_full Autonomous Decision Engine tarafından API/browser seçimi ve otomatik submit ile yürütülür. Approval/manual modları desteklenmez."
        },
        "notes": {
          "type": "string"
        },
        "entryUrl": {
          "type": "string",
          "format": "uri"
        },
        "formFingerprint": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldValue"
          },
          "description": "Tek sayfalık web akışlarının alanları. Çok adımlı akışlar steps kullanır."
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/webStep"
          }
        },
        "submit": {
          "type": "object",
          "required": [
            "locator",
            "requiresApproval"
          ],
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "requiresApproval": {
              "type": "boolean",
              "const": false,
              "description": "0-HITL uyumluluk alanı; daima false. Ara/son adım submit kararı policy ve Autonomous Decision Engine tarafından verilir."
            }
          }
        },
        "success": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/successSignal"
          }
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Yalnızca kind=api. İstek path'lerinin öneki."
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/apiRequest"
          },
          "description": "Yalnızca kind=api."
        },
        "emailCode": {
          "type": "object",
          "description": "Akış-içi doğrulama kodu adımı (#35): success assertion ÖNCESİ koşar, bulunamazsa run fail eder. Kod human-like doldurulur veya link aynı session'da açılır; ham kod/link asla loglanmaz.",
          "required": [],
          "properties": {
            "mailboxRef": {
              "type": "string",
              "description": "vault://... biçiminde kimlik bilgisi referansı."
            },
            "codeSelector": {
              "type": "string",
              "description": "Kodun yazılacağı input seçicisi (kod akışı için gerekli)."
            },
            "linkPattern": {
              "type": "string",
              "description": "Tıklanacak doğrulama bağlantısının regex deseni (link akışı için gerekli)."
            },
            "allowedDomains": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Link SADECE bu domainlerden birindeyse açılır. Boş/yoksa generic link asla açılmaz (fail-closed)."
            },
            "processMode": {
              "enum": ["clickLink", "extractOnly"],
              "default": "clickLink"
            },
            "markProcessed": {
              "type": "boolean",
              "default": true
            },
            "subjectContains": { "type": "string" },
            "fromContains": { "type": "string" },
            "timeoutS": {
              "type": "number",
              "description": "1..600 saniye; kod/link gelmezse run fail eder.",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        "mailbox": {
          "type": "object",
          "description": "Yalnızca kind=email. Kendi gelen kutusunun otomatik okunması ve doğrulama bağlantısına otomatik tıklanması.",
          "required": [
            "protocol",
            "mailboxRef"
          ],
          "properties": {
            "protocol": {
              "enum": [
                "imap",
                "microsoftGraph",
                "googleApi"
              ]
            },
            "mailboxRef": {
              "type": "string",
              "description": "vault://... biçiminde kimlik bilgisi referansı."
            },
            "subjectContains": {
              "type": "string"
            },
            "fromContains": {
              "type": "string",
              "description": "Gönderen adres filtresi (örn. noreply@site.com)."
            },
            "allowedDomains": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Zorunlu güvenlik alanı: link SADECE bu domainlerden birindeyse açılır. Boş/yoksa generic link asla açılmaz (fail-closed)."
            },
            "linkPattern": {
              "type": "string",
              "description": "Tıklanacak doğrulama bağlantısının regex deseni."
            },
            "processMode": {
              "enum": [
                "clickLink",
                "extractOnly"
              ],
              "default": "clickLink"
            },
            "markProcessed": {
              "type": "boolean",
              "default": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "kind"
              ]
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "entryUrl"
                ]
              },
              {
                "required": [
                  "steps"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "entryUrl"
                ]
              },
              {
                "required": [
                  "steps"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "mailbox"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "entryUrl"
                  ]
                },
                {
                  "required": [
                    "fields"
                  ]
                },
                {
                  "required": [
                    "steps"
                  ]
                },
                {
                  "required": [
                    "submit"
                  ]
                },
                {
                  "required": [
                    "formFingerprint"
                  ]
                },
                {
                  "required": [
                    "baseUrl"
                  ]
                },
                {
                  "required": [
                    "requests"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "api"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "baseUrl",
              "requests"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "entryUrl"
                  ]
                },
                {
                  "required": [
                    "fields"
                  ]
                },
                {
                  "required": [
                    "steps"
                  ]
                },
                {
                  "required": [
                    "submit"
                  ]
                },
                {
                  "required": [
                    "formFingerprint"
                  ]
                },
                {
                  "required": [
                    "mailbox"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "persona": {
      "enum": [
        "founder",
        "brand"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "extends": {
      "type": "string",
      "description": "Bu adapter'ın kalıtım aldığı family adapter dosyasının repo-relative yolu (ör. families/generic-directory.adapter.json). Aynı alan burada override edilir; merge sırası: family -> site adapter."
    },
    "policy": {
      "type": "object",
      "required": [
        "sourceUrl",
        "lastCheckedAt",
        "execution",
        "allowedActions",
        "deniedActions"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "execution": {
          "enum": [
            "browser_auto",
            "api_auto",
            "auto_full"
          ],
          "description": "0-HITL execution mode. browser_auto ve api_auto belirli transportu otomatik yürütür; auto_full Autonomous Decision Engine tarafından API/browser seçimi ve otomatik submit ile yürütülür. Approval/manual modları desteklenmez."
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "storageState",
            "oauth",
            "apiKey"
          ]
        },
        "storageStateRef": {
          "type": "string"
        },
        "credentialRef": {
          "type": "string",
          "description": "mode oauth|apiKey iken secret'ın vault:// referansı. Düz metin secret yazılmaz."
        },
        "refreshPolicy": {
          "enum": [
            "onExpiry",
            "scheduled",
            "manual"
          ],
          "description": "Oturum/token yenileme stratejisi; onExpiry iken runner refresh akışını kendisi dener, başarısızsa alert kuyruğuna düşer."
        }
      }
    },
    "limits": {
      "type": "object",
      "description": "Hız sınırları ban riskinin ana kontrolüdür. Browser akışları için maxConcurrency 1 kuralı değişmez; API akışları için worker başına artırılabilir.",
      "properties": {
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "maxActionsPerHour": {
          "type": "integer",
          "minimum": 1
        },
        "maxActionsPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "minDelaySecondsBetweenActions": {
          "type": "integer",
          "minimum": 0
        },
        "quietHours": {
          "$ref": "#/$defs/quietHours"
        }
      }
    },
    "retry": {
      "$ref": "#/$defs/retryPolicy"
    },
    "captcha": {
      "type": "object",
      "description": "CAPTCHA/security-challenge politika alanı — per-action. Eylem Very High/Critical değilse (Low/Moderate/High), site riskli grupta olsa bile vault:// ile auto_ensemble (capsolver → 2captcha → ai_lmm → buster) kullanılabilir. Very High/Critical → auto_quarantine, ensemble yok. Her deneme audit_log.detail_json.captcha maskeli.",
      "properties": {
        "policy": {
          "enum": ["abort_and_notify", "auto_ensemble"],
          "default": "auto_ensemble",
          "description": "auto_ensemble: Low/Moderate/High per-action (High riskli grupta olsa bile, Very High değilse) challenge durumunda agentic ensemble (capsolver→2captcha→ai_lmm→buster) vault:// ile denenir. abort_and_notify: challenge durumunda doğrudan auto_quarantine (Very High/Critical için zorunlu)."
        },
        "strategy": {
          "enum": ["capsolver", "2captcha", "ai_lmm", "buster", "auto_ensemble"],
          "default": "auto_ensemble",
          "description": "auto_ensemble içinde sıra: capsolver → 2captcha → ai_lmm → buster → human Telegram (son çare)."
        },
        "solvers": {
          "type": "array",
          "items": { "enum": ["capsolver", "2captcha", "ai_lmm", "buster", "human_telegram"] },
          "default": ["capsolver", "2captcha", "ai_lmm", "buster"]
        },
        "capSolver": {
          "type": "object",
          "description": "CapSolver primary (2026: $0.80/1k recaptcha+turnstile, AI 2-8sn).",
          "properties": {
            "apiKeyRef": { "type": "string", "description": "vault://captcha/capsolver/apiKey" },
            "server": { "type": "string", "default": "https://api.capsolver.com" },
            "defaultTimeout": { "type": "integer", "default": 120 },
            "pollingInterval": { "type": "integer", "default": 5 }
          }
        },
        "twoCaptcha": {
          "type": "object",
          "properties": {
            "apiKeyRef": { "type": "string", "description": "vault://captcha/2captcha/apiKey" },
            "server": { "type": "string", "default": "2captcha.com" },
            "defaultTimeout": { "type": "integer", "default": 120 },
            "recaptchaTimeout": { "type": "integer", "default": 600 },
            "pollingInterval": { "type": "integer", "default": 10 }
          }
        },
        "aiLmm": {
          "type": "object",
          "description": "aydinnyunus/ai-captcha-bypass — GPT-4o/Gemini",
          "properties": {
            "provider": { "enum": ["openai", "gemini"], "default": "openai" },
            "model": { "type": "string", "default": "gpt-4o" },
            "apiKeyRef": { "type": "string", "description": "vault://llm/openai/apiKey" }
          }
        },
        "buster": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "useBsplineMouse": { "type": "boolean", "default": true }
          }
        },
        "proxyRef": {
          "type": "string",
          "description": "DataDome/Turnstile için zorunlu residential proxy vault://proxy/residential/uri"
        },
        "notifyChannelRef": {
          "type": "string",
          "description": "Bildirim kanalı referansı (ör. telegram://marketing-agent/alerts)."
        },
        "maxHumanSolvesPerDay": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "0-HITL varsayılan 0. auto_ensemble'da son çare human için 5'e kadar izin verilebilir."
        }
      }
    },
    "biometricMouse": {
      "type": "object",
      "description": "wassim-sayah/biometric-mouse — gerçek el FFT profili, 30dk %8 varyans, HER ZAMAN her browser eylemde (Low/Moderate/High per-action) kullanılır; site riskli olsa bile Very High/Critical değilse her zaman. Ban atlatmak için değil, sıradan insan-benzeri input.",
      "properties": {
