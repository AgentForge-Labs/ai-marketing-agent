{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/site-adapter.schema.json",
  "title": "Marketing Site Adapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "siteId",
    "version",
    "lastVerifiedAt",
    "persona",
    "domains",
    "policy",
    "auth",
    "flows"
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "kind"
      ],
      "description": "kind'e göre beklenen alanlar: role -> role (+name); label, placeholder, name, id, testId, text -> value; css -> value (kısa ve bağlama alınmış). Öncelik sırası: role+name > label > placeholder > stabil name/id/testId > kısa CSS fallback.",
      "properties": {
        "kind": {
          "description": "testId data-testid benzeri test kimliği, text görünür metin eşleşmesidir.",
          "enum": [
            "role",
            "label",
            "placeholder",
            "name",
            "id",
            "testId",
            "text",
            "css"
          ]
        },
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "execution"
      ],
      "description": "kind varsayılan olarak 'web'dir. kind=email ise akış site içi bir form değil, doğrulama e-postasının manuel kutudan takibidir (ör. emailVerification).",
      "properties": {
        "kind": {
          "enum": [
            "web",
            "email"
          ],
          "description": "email: submit sonrası e-posta doğrulama gibi site dışı manuel adım."
        },
        "execution": {
          "enum": [
            "manual_only",
            "draft_only",
            "browser_with_submit_approval",
            "api_with_approval",
            "api_auto"
          ]
        },
        "entryUrl": {
          "type": "string",
          "format": "uri"
        },
        "mailboxRef": {
          "type": "string",
          "description": "vault://... biçiminde izlenecek gelen kutusu referansı; yalnızca kind=email için geçerlidir."
        },
        "formFingerprint": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "valueFrom",
              "locators"
            ],
            "properties": {
              "valueFrom": {
                "type": "string"
              },
              "locators": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/locator"
                }
              }
            }
          }
        },
        "submit": {
          "type": "object",
          "required": [
            "locator",
            "requiresApproval"
          ],
          "properties": {
            "locator": {
              "$ref": "#/$defs/locator"
            },
            "requiresApproval": {
              "type": "boolean"
            }
          }
        },
        "success": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "matches"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "url",
                  "text",
                  "apiResponseId"
                ]
              },
              "matches": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "kind": {
                  "const": "email"
                }
              },
              "required": [
                "kind"
              ]
            }
          },
          "then": {
            "required": [
              "entryUrl"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "mailboxRef"
            ],
            "not": {
              "anyOf": [
                { "required": ["entryUrl"] },
                { "required": ["fields"] },
                { "required": ["submit"] },
                { "required": ["formFingerprint"] }
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "lastVerifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "persona": {
      "enum": [
        "founder",
        "brand"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "sourceUrl",
        "lastCheckedAt",
        "execution",
        "allowedActions",
        "deniedActions"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "lastCheckedAt": {
          "type": "string",
          "format": "date-time"
        },
        "execution": {
          "enum": [
            "manual_only",
            "draft_only",
            "browser_with_submit_approval",
            "api_with_approval",
            "api_auto"
          ]
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deniedActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "manual",
            "storageState",
            "oauth",
            "apiKey"
          ]
        },
        "storageStateRef": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        }
      }
    },
    "flows": {
      "type": "object",
      "description": "Anahtarlar flow adıdır: register, login, submitListing, post, comment, dm, emailVerification vb. emailVerification her zaman kind=email tanımlanır.",
      "additionalProperties": {
        "$ref": "#/$defs/flow"
      }
    }
  }
}
