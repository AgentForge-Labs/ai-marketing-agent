{
  "schemaVersion": "1.1.0",
  "siteId": "aistack-directory",
  "version": 1,
  "lastVerifiedAt": "2026-08-26T00:00:00Z",
  "persona": "brand",
  "domains": [
    "aistack.directory"
  ],
  "extends": "families/generic-directory.adapter.json",
  "policy": {
    "sourceUrl": "https://aistack.directory/terms",
    "lastCheckedAt": "2026-08-26T00:00:00Z",
    "execution": "browser_auto",
    "allowedActions": [
      "register",
      "login",
      "submitListing"
    ],
    "deniedActions": [
      "bulkDm",
      "autoComment",
      "fakeReview"
    ]
  },
  "auth": {
    "mode": "storageState",
    "storageStateRef": "vault://sites/aistack-directory/brand",
    "refreshPolicy": "onExpiry"
  },
  "limits": {
    "maxConcurrency": 1,
    "maxActionsPerHour": 3,
    "maxActionsPerDay": 8,
    "minDelaySecondsBetweenActions": 45,
    "quietHours": {
      "startLocal": "01:00",
      "endLocal": "06:00",
      "timezone": "Europe/Berlin"
    }
  },
  "retry": {
    "maxAttempts": 3,
    "backoffSeconds": [
      300,
      1800,
      7200
    ],
    "retryOn": [
      "timeout",
      "networkError",
      "rateLimited"
    ]
  },
  "captcha": {
    "policy": "auto_ensemble",
    "strategy": "auto_ensemble",
    "solvers": ["capsolver", "2captcha", "ai_lmm", "buster"],
    "capSolver": {
      "apiKeyRef": "vault://captcha/capsolver/apiKey",
      "server": "https://api.capsolver.com",
      "defaultTimeout": 120,
      "pollingInterval": 5
    },
    "twoCaptcha": {
      "apiKeyRef": "vault://captcha/2captcha/apiKey",
      "server": "2captcha.com",
      "defaultTimeout": 120,
      "recaptchaTimeout": 600,
      "pollingInterval": 10
    },
    "aiLmm": {
      "provider": "openai",
      "model": "gpt-4o",
      "apiKeyRef": "vault://llm/openai/apiKey",
      "solverTypes": ["text", "recaptcha_v2", "puzzle"]
    },
    "buster": {
      "enabled": true,
      "useBsplineMouse": true
    },
    "proxyRef": "vault://proxy/residential/uri",
    "notifyChannelRef": "telegram://marketing-agent/alerts",
    "maxHumanSolvesPerDay": 0
  },
  "biometricMouse": {
    "enabled": true,
    "profileRef": "vault://mouse/profile/mouse_profile.json",
    "rotationMinutes": 30,
    "variancePercent": 8,
    "source": "ai_mouse/playwright_integration.py PlaywrightHumanMouse"
  },
  "semanticBrowser": {
    "enabled": true,
    "serviceUrl": "http://127.0.0.1:8765",
    "mode": "summary",
    "topActions": 25,
    "useForDiscovery": true,
    "useForDriftRepair": true
  },
  "flows": {
    "register": {
      "execution": "browser_auto",
      "entryUrl": "https://aistack.directory/signup",
      "formFingerprint": "sha256:replace-after-recording",
      "fields": [
        {
          "valueFrom": "identity.brand.email",
          "fieldType": "email",
          "locators": [
            {
              "kind": "label",
              "name": "Work email"
            },
            {
              "kind": "css",
              "value": "input[name='email']"
            }
          ]
        },
        {
          "valueFrom": "vault://sites/aistack-directory/brand/password",
          "fieldType": "password",
          "locators": [
            {
              "kind": "label",
              "name": "Password"
            }
          ]
        },
        {
          "valueFrom": "product.name",
          "fieldType": "text",
          "locators": [
            {
              "kind": "label",
              "name": "Company"
            }
          ]
        }
      ],
      "submit": {
        "locator": {
          "kind": "role",
          "role": "button",
          "name": "Create account"
        },
        "requiresApproval": false
      },
      "success": [
        {
          "kind": "url",
          "matches": "/dashboard"
        },
        {
          "kind": "text",
          "matches": "verify your email"
        }
      ]
    },
    "submitListing": {
      "execution": "browser_auto",
      "entryUrl": "https://aistack.directory/submit",
      "formFingerprint": "sha256:replace-after-recording",
      "steps": [
        {
          "name": "basics",
          "fields": [
            {
              "valueFrom": "product.name",
              "fieldType": "text",
              "locators": [
                {
                  "kind": "label",
                  "name": "Product name"
                },
                {
                  "kind": "testId",
                  "value": "listing-name-input"
                }
              ]
            },
            {
              "valueFrom": "product.website",
              "fieldType": "text",
              "locators": [
                {
                  "kind": "label",
                  "name": "Website"
                }
              ]
            },
            {
              "valueFrom": "product.tagline.short",
              "fieldType": "textarea",
              "maxLength": 120,
              "locators": [
                {
                  "kind": "placeholder",
                  "value": "One-line pitch"
                }
              ]
            }
          ],
          "submit": {
            "locator": {
              "kind": "role",
              "role": "button",
              "name": "Next step"
            },
            "requiresApproval": false
          },
          "wait": {
            "kind": "text",
            "matches": "Tell us more"
          }
        },
        {
          "name": "details",
          "fields": [
            {
              "valueFrom": "product.description.medium",
              "fieldType": "richtext",
              "maxLength": 1000,
              "locators": [
                {
                  "kind": "css",
                  "value": "[contenteditable='true'].editor"
                },
                {
                  "frame": [
                    "#editor-iframe"
                  ],
                  "kind": "css",
                  "value": "body.editor-frame"
                }
              ]
            },
            {
              "valueFrom": "product.category.primary",
              "fieldType": "select",
              "optionsValueFrom": "taxonomy.aistack.categories",
              "locators": [
                {
                  "kind": "label",
                  "name": "Category"
                }
              ]
            },
            {
              "valueFrom": "product.integrations",
              "fieldType": "multiselect",
              "optionsValueFrom": "taxonomy.aistack.integrations",
              "locators": [
                {
                  "kind": "label",
                  "name": "Works with"
                }
              ]
            },
            {
              "valueFrom": "product.pricing.hasFreeTier",
              "fieldType": "checkbox",
              "condition": {
                "field": "product.category.primary",
                "equals": "ai-tools"
              },
              "locators": [
                {
                  "kind": "label",
                  "name": "Has a free plan"
                }
              ]
            }
          ],
          "submit": {
            "locator": {
              "kind": "role",
              "role": "button",
              "name": "Next step"
            },
            "requiresApproval": false
          },
          "wait": {
            "kind": "selector",
            "matches": "#asset-upload"
          }
        },
        {
          "name": "assets",
          "fields": [
            {
              "valueFrom": "assets.logoPath",
              "fieldType": "file",
              "uploadRef": "vault://assets/logo.png",
              "locators": [
                {
                  "kind": "css",
                  "value": "input[type='file'][accept*='image'][name='logo']"
                }
              ]
            },
            {
              "valueFrom": "assets.screenshotPaths[0]",
              "fieldType": "file",
              "uploadRef": "vault://assets/screenshots/main.png",
              "locators": [
                {
                  "kind": "css",
                  "value": "input[type='file'][name='screenshot']"
                }
              ]
            }
          ],
          "submit": {
            "locator": {
              "kind": "role",
              "role": "button",
              "name": "Submit listing"
            },
            "requiresApproval": false
          },
          "wait": {
            "kind": "url",
            "matches": "/submission/"
          }
        }
      ],
      "success": [
        {
          "kind": "url",
          "matches": "/listing/"
        },
        {
          "kind": "text",
          "matches": "is live"
        }
      ]
    },
    "emailVerification": {
      "kind": "email",
      "execution": "api_auto",
      "mailbox": {
        "protocol": "imap",
        "mailboxRef": "vault://sites/aistack-directory/brand/inbox",
        "subjectContains": "Confirm your listing",
        "linkPattern": "https://aistack\\.directory/verify\\?token=",
        "processMode": "clickLink",
        "markProcessed": true
      },
      "success": [
        {
          "kind": "url",
          "matches": "/listing/"
        }
      ]
    }
  },
  "notes": "Karmaşık site örneği: çok adımlı wizard, richtext + iframe locator, select/multiselect option eşleme, koşullu alan, dosya yükleme, otomatik IMAP e-posta doğrulaması, hız sınırları ve retry politikası."
}
